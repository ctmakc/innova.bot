---
const useCases = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Tax & Offshore Consulting',
    description: 'Ask about 300+ jurisdictions. Get instant answers on corporate tax, VAT, transfer pricing, and offshore structures.',
    color: 'neon',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`,
    title: 'Legal Research',
    description: 'Instant corporate law answers. Search through legislation, case law, and regulatory frameworks effortlessly.',
    color: 'electric',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    title: 'Lead Qualification',
    description: '24/7 pre-qualification via chat. Automatically qualify leads, collect requirements, and schedule consultations.',
    color: 'neon',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
    title: 'Document Analysis',
    description: 'Upload contracts, get AI review. Analyze agreements, identify risks, and extract key terms automatically.',
    color: 'electric',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Multilingual Support',
    description: 'EN, RU, UK, DE, FR, ES — communicate with Eva in your preferred language, with more languages coming soon.',
    color: 'neon',
  },
];
---

<section id="use-cases" class="py-20 md:py-28">
  <div class="section-container">
    <div class="text-center mb-16">
      <span class="text-neon font-heading text-sm tracking-widest uppercase">Capabilities</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mt-4 mb-6">
        What Eva Can Do <span class="text-neon glow-text">For You</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-lg">
        From tax consulting to document analysis — Eva handles the heavy lifting so you can focus on growing your business.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {useCases.map((uc, i) => (
        <div class:list={[
          'card-dark group',
          i === 4 && 'md:col-span-2 lg:col-span-1'
        ]}>
          <div class:list={[
            'w-14 h-14 rounded-lg flex items-center justify-center mb-4 transition-all duration-300',
            uc.color === 'neon'
              ? 'bg-neon/10 text-neon group-hover:shadow-neon'
              : 'bg-electric/10 text-electric group-hover:shadow-electric'
          ]}>
            <Fragment set:html={uc.icon} />
          </div>
          <h3 class="font-heading text-xl font-bold mb-3">{uc.title}</h3>
          <p class="text-gray-400 leading-relaxed">{uc.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
