---
const stats = [
  { value: '300+', label: 'Jurisdictions', icon: '🌍' },
  { value: '12+', label: 'Years Expertise', icon: '📊' },
  { value: '24/7', label: 'Availability', icon: '⚡' },
  { value: '6', label: 'Languages', icon: '🌐' },
];
---

<section class="py-16 md:py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-neon/5 via-transparent to-electric/5 pointer-events-none"></div>
  <div class="section-container relative">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {stats.map((stat) => (
        <div class="text-center group">
          <div class="text-3xl mb-3">{stat.icon}</div>
          <div class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-neon glow-text mb-2 group-hover:animate-glow transition-all">
            {stat.value}
          </div>
          <div class="text-gray-400 font-body text-sm md:text-base">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
