---
const plans = [
  {
    name: 'Free',
    price: '$0',
    period: '/month',
    description: 'Perfect for trying Eva out',
    features: [
      '50 messages/month',
      'Basic tax & legal knowledge',
      'Single language',
      'Web chat widget',
      'Community support',
    ],
    cta: 'Start Free',
    popular: false,
    color: 'gray',
  },
  {
    name: 'Business',
    price: '$99',
    period: '/month',
    description: 'For growing consulting firms',
    features: [
      'Unlimited messages',
      'Full 300+ jurisdiction database',
      'All 6 languages',
      'Telegram + WhatsApp + Web',
      'Document analysis',
      'Lead qualification',
      'Priority support',
    ],
    cta: 'Get Started',
    popular: true,
    color: 'neon',
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: '',
    description: 'For large organizations',
    features: [
      'Everything in Business',
      'Custom AI training',
      'API access',
      'Dedicated account manager',
      'SLA guarantee',
      'On-premise deployment',
      'White-label option',
    ],
    cta: 'Contact Us',
    popular: false,
    color: 'electric',
  },
];
---

<section id="pricing" class="py-20 md:py-28">
  <div class="section-container">
    <div class="text-center mb-16">
      <span class="text-neon font-heading text-sm tracking-widest uppercase">Pricing</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mt-4 mb-6">
        Simple, Transparent <span class="text-neon glow-text">Pricing</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-lg">
        Start free. Scale as you grow. No hidden fees.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
      {plans.map((plan) => (
        <div class:list={[
          'card-dark relative flex flex-col',
          plan.popular && 'border-neon/50 shadow-neon'
        ]}>
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-neon text-dark text-xs font-heading font-bold px-4 py-1 rounded-full">
              Most Popular
            </div>
          )}
          <div class="mb-6">
            <h3 class="font-heading text-xl font-bold mb-2">{plan.name}</h3>
            <p class="text-gray-500 text-sm mb-4">{plan.description}</p>
            <div class="flex items-baseline gap-1">
              <span class:list={[
                'font-heading text-4xl font-bold',
                plan.color === 'neon' ? 'text-neon' : plan.color === 'electric' ? 'text-electric' : 'text-white'
              ]}>
                {plan.price}
              </span>
              <span class="text-gray-500 text-sm">{plan.period}</span>
            </div>
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-gray-300 text-sm">
                <svg class:list={[
                  'w-5 h-5 flex-shrink-0 mt-0.5',
                  plan.color === 'neon' ? 'text-neon' : plan.color === 'electric' ? 'text-electric' : 'text-gray-500'
                ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <a href="#contact" class:list={[
            'block text-center py-3 rounded-lg font-heading font-bold text-sm transition-all duration-300',
            plan.popular
              ? 'btn-neon'
              : plan.color === 'electric'
                ? 'btn-outline'
                : 'border border-dark-border text-gray-400 hover:border-gray-500 hover:text-white'
          ]}>
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
