---
import HeroChat from './HeroChat';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <!-- Particles background -->
  <div class="absolute inset-0 pointer-events-none" id="particles-container">
    {Array.from({ length: 30 }).map((_, i) => (
      <div
        class="particle"
        style={`left: ${Math.random() * 100}%; animation-duration: ${5 + Math.random() * 10}s; animation-delay: ${Math.random() * 5}s; opacity: ${0.2 + Math.random() * 0.5};`}
      />
    ))}
  </div>

  <!-- Gradient overlays -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-neon/5 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-electric/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="section-container relative z-10 py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left content -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-neon/10 border border-neon/20 rounded-full px-4 py-2 mb-6">
          <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
          <span class="text-neon text-xs font-heading font-bold">AI-Powered Business Assistant</span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-bold leading-tight mb-6">
          Your AI<br />
          <span class="text-neon glow-text">Business</span><br />
          <span class="text-electric glow-text-electric">Partner</span>
        </h1>

        <p class="text-gray-400 text-lg md:text-xl max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed">
          Eva helps tax consultants, lawyers, and business advisors deliver expert-level answers instantly across 300+ jurisdictions.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
          <a href="#demo" class="btn-neon text-base px-8 py-4 w-full sm:w-auto text-center">
            Try Eva Now
          </a>
          <a href="#how-it-works" class="btn-outline text-base px-8 py-4 w-full sm:w-auto text-center">
            See How It Works
          </a>
        </div>

        <!-- Trust badges -->
        <div class="flex items-center gap-6 mt-10 justify-center lg:justify-start text-gray-600 text-sm">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            No credit card
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Free plan
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Setup in 5 min
          </span>
        </div>
      </div>

      <!-- Right: Animated chat demo -->
      <div class="flex justify-center lg:justify-end">
        <HeroChat client:load />
      </div>
    </div>
  </div>
</section>
