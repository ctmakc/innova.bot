---
const steps = [
  {
    num: '01',
    title: 'Connect',
    description: 'Integrate Eva into your website, Telegram, WhatsApp, or any messenger in minutes. No coding required.',
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>`,
  },
  {
    num: '02',
    title: 'Train on Your Data',
    description: 'Upload your knowledge base, documents, and FAQs. Eva learns your business and speaks your language.',
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
  },
  {
    num: '03',
    title: 'Deploy & Scale',
    description: 'Go live instantly. Eva works 24/7, handles unlimited conversations, and keeps getting smarter.',
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  },
];
---

<section id="how-it-works" class="py-20 md:py-28 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-neon/[0.02] to-transparent pointer-events-none"></div>
  <div class="section-container relative">
    <div class="text-center mb-16">
      <span class="text-electric font-heading text-sm tracking-widest uppercase">Simple Setup</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mt-4 mb-6">
        How It <span class="text-electric glow-text-electric">Works</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-lg">
        Get Eva up and running in three simple steps.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connector line (desktop) -->
      <div class="hidden md:block absolute top-24 left-[20%] right-[20%] h-px bg-gradient-to-r from-neon/50 via-electric/50 to-neon/50"></div>

      {steps.map((step) => (
        <div class="card-dark text-center relative group">
          <!-- Step number -->
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-dark px-4">
            <span class="font-heading text-neon text-sm font-bold">{step.num}</span>
          </div>
          <!-- Icon -->
          <div class="w-20 h-20 mx-auto rounded-full bg-neon/5 border border-neon/20 flex items-center justify-center text-neon mb-6 group-hover:shadow-neon transition-all duration-500">
            <Fragment set:html={step.icon} />
          </div>
          <h3 class="font-heading text-2xl font-bold mb-4">{step.title}</h3>
          <p class="text-gray-400 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
